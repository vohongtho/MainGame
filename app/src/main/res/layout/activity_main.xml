<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050A07">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="performance"
        app:scaleType="fillCenter" />

    <View
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:layout_gravity="top"
        android:background="#26000000" />

    <com.example.treedirectiondemo.TreeOverlayView
        android:id="@+id/treeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <Button
        android:id="@+id/btnMenu"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="14dp"
        android:layout_marginTop="18dp"
        android:backgroundTint="#8E23322A"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="☰"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

    <Button
        android:id="@+id/btnDebug"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="14dp"
        android:backgroundTint="#8E23322A"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="⚙"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="19sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="72dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvGpsStatus"
            android:layout_width="122dp"
            android:layout_height="44dp"
            android:background="#D51A2921"
            android:gravity="center"
            android:text="GPS WAITING"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCompassStatus"
            android:layout_width="132dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="#D51A2921"
            android:gravity="center"
            android:text="HEADING WAITING"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDirection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="104dp"
        android:gravity="center"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="5"
        android:text="Acquiring direction…"
        android:textColor="#55E66F"
        android:textSize="22sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnResetTree"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="28dp"
        android:backgroundTint="#E01C2923"
        android:text="🌳  Place test tree 35 m ahead"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDistance"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/tvCoordinates"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/tvDebug"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="20dp"
        android:background="#F20B120E"
        android:fontFamily="monospace"
        android:maxLines="18"
        android:padding="18dp"
        android:textColor="#E9F5EC"
        android:textSize="11sp"
        android:visibility="gone" />

</FrameLayout>
