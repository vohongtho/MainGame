<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050A07">

    <com.example.treedirectiondemo.ArCoreCameraView
        android:id="@+id/arView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.example.treedirectiondemo.TreeOverlayView
        android:id="@+id/treeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- MAIN CAMERA UI -->
    <Button
        android:id="@+id/btnMenu"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="14dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_circle_dark"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="☰"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btnSettings"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_circle_dark"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="⚙"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="72dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvGpsStatus"
            android:layout_width="128dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_chip_good"
            android:gravity="center"
            android:text="GPS  WAITING"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCompassStatus"
            android:layout_width="136dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_chip_good"
            android:gravity="center"
            android:text="HEADING  WAITING"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/gpsWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="166dp"
        android:background="@drawable/bg_warning"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠  GPS accuracy is limited"
            android:textColor="#FFC34F"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Move to a more open area for a better global position. AR tracking will keep the current tree marker stable."
            android:textColor="#E7E1CC"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDirection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="104dp"
        android:gravity="center"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="5"
        android:text="Acquiring AR tracking…"
        android:textColor="#55E66F"
        android:textSize="21sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnResetTree"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_pill_dark"
        android:text="🌳  Place test tree 35 m ahead"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- MENU -->
    <LinearLayout
        android:id="@+id/panelMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="30dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🌳  TREE NAVIGATOR"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btnMenuClose"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_dark"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="×"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/menuHome"
            style="@style/MenuRow"
            android:layout_marginTop="26dp"
            android:text="⌂   Home" />
        <TextView android:id="@+id/menuDiagnostics" style="@style/MenuRow" android:text="▣   Diagnostics" />
        <TextView android:id="@+id/menuCreate" style="@style/MenuRow" android:text="♧   Create test tree" />
        <TextView android:id="@+id/menuSettings" style="@style/MenuRow" android:text="⚙   Settings" />
        <TextView android:id="@+id/menuCalibration" style="@style/MenuRow" android:text="◎   Calibrate compass" />
        <TextView android:id="@+id/menuGuide" style="@style/MenuRow" android:text="▤   User guide" />
        <TextView android:id="@+id/menuAbout" style="@style/MenuRow" android:text="ⓘ   About" />

        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <TextView
            android:id="@+id/menuExit"
            style="@style/MenuRow"
            android:text="↪   Exit"
            android:textColor="#FF6259" />
    </LinearLayout>

    <!-- CREATE TREE -->
    <LinearLayout
        android:id="@+id/panelCreate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <LinearLayout style="@style/ScreenHeader">
            <Button android:id="@+id/btnCreateBack" style="@style/BackButton" android:text="←" />
            <TextView style="@style/ScreenTitle" android:text="Create test tree" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Create a fixed tree target in the direction you are currently facing. ARCore will lock its visual position in the real world."
            android:textColor="#B7C9BD"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="132dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="20dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🚶" android:textSize="34sp" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:background="#8CA39A" />
            <TextView android:id="@+id/tvCreateDistanceHero" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="35 m" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:background="#8CA39A" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌳" android:textSize="38sp" />
        </LinearLayout>

        <LinearLayout style="@style/SettingCard" android:layout_marginTop="18dp">
            <TextView style="@style/SettingLabel" android:text="Distance" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
                <Button android:id="@+id/btnDistanceMinus" style="@style/SmallControlButton" android:text="−" />
                <TextView android:id="@+id/tvCreateDistance" android:layout_width="72dp" android:layout_height="44dp" android:gravity="center" android:text="35 m" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
                <Button android:id="@+id/btnDistancePlus" style="@style/SmallControlButton" android:text="+" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/SettingCard">
            <TextView style="@style/SettingLabel" android:text="Direction" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Current view  ›" android:textColor="#DCE8DF" android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout style="@style/SettingCard">
            <TextView style="@style/SettingLabel" android:text="Elevation offset" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 m  ›" android:textColor="#DCE8DF" android:textSize="14sp" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <Button
            android:id="@+id/btnCreateNow"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_primary_green"
            android:text="CREATE NOW"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- SETTINGS -->
    <LinearLayout
        android:id="@+id/panelSettings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">
        <LinearLayout style="@style/ScreenHeader">
            <Button android:id="@+id/btnSettingsBack" style="@style/BackButton" android:text="←" />
            <TextView style="@style/ScreenTitle" android:text="Settings" />
        </LinearLayout>
        <TextView style="@style/SectionLabel" android:layout_marginTop="26dp" android:text="DISPLAY" />
        <LinearLayout style="@style/SettingCard">
            <TextView style="@style/SettingLabel" android:text="Show distance" />
            <Switch android:id="@+id/swDistance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
        </LinearLayout>
        <LinearLayout style="@style/SettingCard">
            <TextView style="@style/SettingLabel" android:text="Show direction guidance" />
            <Switch android:id="@+id/swGuidance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
        </LinearLayout>
        <LinearLayout style="@style/SettingCard">
            <TextView style="@style/SettingLabel" android:text="Distance unit" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Meters (m)  ›" android:textColor="#DCE8DF" android:textSize="14sp" />
        </LinearLayout>
        <TextView style="@style/SectionLabel" android:layout_marginTop="20dp" android:text="TRACKING &amp; STABILITY" />
        <LinearLayout style="@style/SettingCard">
            <TextView style="@style/SettingLabel" android:text="ARCore world lock" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Required" android:textColor="#55E66F" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout style="@style/SettingCard">
            <TextView style="@style/SettingLabel" android:text="True north correction" />
            <Switch android:id="@+id/swTrueNorth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
        </LinearLayout>
        <LinearLayout style="@style/SettingCard">
            <TextView style="@style/SettingLabel" android:text="Micro-jitter stabilization" />
            <Switch android:id="@+id/swStability" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- DIAGNOSTICS -->
    <LinearLayout
        android:id="@+id/panelDiagnostics"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">
        <LinearLayout style="@style/ScreenHeader">
            <Button android:id="@+id/btnDiagBack" style="@style/BackButton" android:text="←" />
            <TextView style="@style/ScreenTitle" android:text="Diagnostics" />
        </LinearLayout>
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="18dp">
            <TextView
                android:id="@+id/tvDiagnostics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:fontFamily="monospace"
                android:lineSpacingExtra="7dp"
                android:padding="18dp"
                android:text="Waiting for tracking data…"
                android:textColor="#DCE8DF"
                android:textSize="13sp" />
        </ScrollView>
        <Button
            android:id="@+id/btnCalibrateFromDiag"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_outline"
            android:text="CALIBRATE COMPASS"
            android:textColor="#55E66F"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- COMPASS CALIBRATION -->
    <LinearLayout
        android:id="@+id/panelCalibration"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_panel"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">
        <LinearLayout style="@style/ScreenHeader">
            <Button android:id="@+id/btnCalibrationBack" style="@style/BackButton" android:text="←" />
            <TextView style="@style/ScreenTitle" android:text="Calibrate compass" />
        </LinearLayout>
        <TextView android:layout_width="220dp" android:layout_height="220dp" android:layout_marginTop="48dp" android:background="@drawable/bg_card" android:gravity="center" android:text="📱\n\n∞" android:textAlignment="center" android:textColor="#55E66F" android:textSize="42sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:gravity="center" android:text="Move your phone in a figure-eight pattern" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="Keep the phone away from vehicles, magnets and large metal objects." android:textColor="#AFC2B5" android:textSize="13sp" />
        <TextView android:id="@+id/tvCalibrationHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="center" android:text="Heading quality: Acquiring" android:textColor="#55E66F" android:textSize="14sp" android:textStyle="bold" />
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <Button android:id="@+id/btnCalibrationDone" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/bg_primary_green" android:text="DONE" android:textColor="#FFFFFF" android:textStyle="bold" />
    </LinearLayout>

    <!-- USER GUIDE -->
    <LinearLayout
        android:id="@+id/panelGuide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">
        <LinearLayout style="@style/ScreenHeader">
            <Button android:id="@+id/btnGuideBack" style="@style/BackButton" android:text="←" />
            <TextView style="@style/ScreenTitle" android:text="User guide" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:background="@drawable/bg_card" android:lineSpacingExtra="8dp" android:padding="18dp" android:text="1. Wait until GPS and AR tracking are ready.\n\n2. Tap ‘Place test tree 35 m ahead’ or use Create test tree.\n\n3. Walk toward the target. ARCore keeps the visual marker locked even when GPS moves.\n\n4. Move the camera up, down, left or right. The marker follows the real AR anchor projection.\n\n5. Walk past the target. The app shows ‘Tree is behind you’ and asks you to turn around.\n\n6. If GPS is poor, the global coordinate may be less accurate, but an existing AR anchor remains stable while tracking is healthy." android:textColor="#DCE8DF" android:textSize="14sp" />
    </LinearLayout>

    <!-- ABOUT -->
    <LinearLayout
        android:id="@+id/panelAbout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">
        <LinearLayout style="@style/ScreenHeader">
            <Button android:id="@+id/btnAboutBack" style="@style/BackButton" android:text="←" />
            <TextView style="@style/ScreenTitle" android:text="About" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="34dp" android:gravity="center" android:text="🌳\nTREE NAVIGATOR" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/bg_card" android:lineSpacingExtra="7dp" android:padding="18dp" android:text="Version 2.0\n\nTracking engine: ARCore visual-inertial world tracking + AR anchor projection.\n\nGlobal reference: GPS + true-north compass correction.\n\nThis application runs on Google Play Services for AR (ARCore), provided by Google LLC and governed by the Google Privacy Policy." android:textColor="#C8D8CE" android:textSize="14sp" />
    </LinearLayout>

</FrameLayout>
